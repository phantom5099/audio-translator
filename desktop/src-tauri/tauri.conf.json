{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "音频翻译",
  "version": "0.1.0",
  "identifier": "com.audio.translator.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "音频翻译", "width": 860, "height": 720, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "externalBin": ["binaries/ffprobe", "binaries/ffmpeg"]
  }
}
