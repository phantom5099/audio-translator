# Rust build artifacts
/target/
/target-workspace-check/
/backend/Cargo.lock
/desktop/node_modules/
/desktop/dist/
/desktop/package-lock.json

# Tauri sidecar binaries (ffmpeg/ffprobe, 体积大，按 target-triple 单独下载)
/desktop/src-tauri/binaries/

# Tauri 构建生成的 capabilities（由 cargo tauri dev/build 自动生成）
/desktop/src-tauri/capabilities/

# Tauri codegen 生成的 ACL/能力 schema（每次 build 重新生成，社区主流不入 git）
